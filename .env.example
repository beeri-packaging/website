# Production site URL — REQUIRED in production. Feeds the sitemap, robots,
# every per-page canonical/hreflang and the Organization JSON-LD. No trailing slash.
NEXT_PUBLIC_SITE_URL=https://www.beeripacks.co.il

# Sanity CMS
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01
SANITY_API_READ_TOKEN=
SANITY_API_WRITE_TOKEN=

# Contact form delivery (Resend — https://resend.com)
# RESEND_API_KEY: from the Resend dashboard.
# CONTACT_FROM_EMAIL must be on a Resend-verified domain (verify beeripacks.co.il via DNS).
RESEND_API_KEY=
CONTACT_TO_EMAIL=orders@beeripacks.co.il
CONTACT_FROM_EMAIL=inquiries@beeripacks.co.il
